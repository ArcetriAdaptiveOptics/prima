    ]
    add_lib_path = [daoroot + '/lib', daoroot + '/lib64/']

if bld.options.debug_flag:
    add_c_flags += ['/Zi'] if is_win else ['-g']

if bld.options.sanitizer_flag and not is_win:
    add_c_flags += ['-g', '-fsanitize=address']
    add_ld_flags += ['-fsanitize=address']

wall = [] if is_win else ['-Wall', '-Wextra', '-pipe', '-fdiagnostics-color']
dbg = ['/Zi'] if is_win else ['-g']


def _prog(source, target, extra_cflags=None, use=None, no_daotools=False):
    use = use or ['daoBase', 'ARAVIS']
    kw = dict(
        source=source,
        target=target,
        includes=add_include_path,
        libpath=add_lib_path,
        cflags=wall + add_c_flags + (extra_cflags or []),
        use=use,
    )
    if is_win:
        libs = list(win_libs)
        if no_daotools:
            libs = [x for x in libs if x != 'daoTools']
        kw['lib'] = libs
        kw['linkflags'] = list(linkflags)
        kw['ldflags'] = []
    else:
        ld = list(add_ld_flags)
        if no_daotools:
            ld = [x for x in ld if x != '-ldaoTools']
        kw['ldflags'] = ld
    return bld.program(**kw)


def _shlib(source, target, extra_cflags=None, use=None):
    use = use or ['daoBase', 'ARAVIS']
    kw = dict(
        source=source,
        target=target,
        includes=add_include_path,
        libpath=add_lib_path,
        cflags=wall + add_c_flags + (extra_cflags or []),
        use=use,
    )
    if is_win:
        kw['lib'] = list(win_libs)
        kw['linkflags'] = list(linkflags)
        kw['ldflags'] = []
    else:
        kw['ldflags'] = list(add_ld_flags)
    return bld.shlib(**kw)


