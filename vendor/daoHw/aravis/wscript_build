    add_lib_path = [daoroot + '/lib', vcpkg + '/lib']
    linkflags = ['/LIBPATH:' + daoroot + '/lib', '/LIBPATH:' + vcpkg + '/lib']
else:
    add_ld_flags += ['-lnuma', '-lrt', '-ldao', '-ldaoTools', '-lpthread', '-lm']
    add_c_flags += ['-Ofast']
    add_include_path += [
        '/usr/include/glib-2.0',
