        '/D_CRT_NONSTDC_NO_DEPRECATE',
        '/D_USE_MATH_DEFINES',
        '/DWIN32_LEAN_AND_MEAN',
        '/D_WINSOCKAPI_',
        '/FI' + wincompat.replace('\\', '/') + '/gcc_attrs.h',
