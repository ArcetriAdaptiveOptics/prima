  <property name="styleSheet">
   <string notr="true">QWidget#Form {
    background-color: #1e1e1e;
}

QLabel, QCheckBox, QGroupBox, QSpinBox, QDoubleSpinBox, QComboBox {
    color: #dcdcdc;
}

QFrame#frame, QFrame#frame_2 {
    background-color: #262626;
    border: 1px solid #3c3c3c;
    border-radius: 6px;
}

QPushButton {
    background-color: #333333;
    color: #dcdcdc;
    border: 1px solid #555555;
    border-radius: 4px;
    padding: 3px 6px;
}
QPushButton:hover   { background-color: #3d3d3d; }
QPushButton:pressed { background-color: #4a4a4a; }
QPushButton:checked { background-color: #5a5a5a; color: #ffffff; }

QSpinBox, QDoubleSpinBox, QComboBox {
    background-color: #1c1c1c;
    border: 1px solid #3c3c3c;
    border-radius: 3px;
    padding: 1px 3px;
}

QCheckBox::indicator {
    width: 14px; height: 14px;
    border: 1px solid #6e6e6e;
    border-radius: 3px;
    background: #1c1c1c;
}
QCheckBox::indicator:checked { background: #8a8a8a; }

QProgressBar {
    border: 1px solid #3c3c3c;
    border-radius: 4px;
    text-align: center;
    color: #dcdcdc;
    background: #1c1c1c;
}
QProgressBar::chunk {
    background-color: #6a6a6a;
    border-radius: 3px;
}

QLabel#msgLabel {
    border: 1px solid #4a4a4a;
    border-radius: 3px;
    color: #c8c8c8;
}

QComboBox QAbstractItemView {
    background-color: #262626;
    color: #dcdcdc;
    selection-background-color: #454545;
    selection-color: #ffffff;
    border: 1px solid #6e6e6e;
    outline: 0;
}
</string>
