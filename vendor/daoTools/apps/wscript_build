import os
import platform

daoroot = os.getenv('DAOROOT', '')
vcpkg = os.getenv('VCPKG_PREFIX', r'C:/Users/labot/DAO/vcpkg/installed/x64-windows')
wincompat = os.getenv('DAO_WINCOMPAT', r'C:/Users/labot/DAO/wincompat')
is_win = platform.system() == "Windows"
is_darwin = platform.system() == "Darwin"

if is_darwin:
	my_ld_flags = ['']
	my_cxx_flags = ['-std=c++14']
	my_cflags = ['-O3', '-ffast-math']
	my_link_flags = ['-Lsrc', '-L' + daoroot + '/lib/']
	if os.path.exists('/opt/homebrew/lib'):
		my_link_flags.append('-L/opt/homebrew/lib')
	if os.path.exists('/usr/local/lib'):
		my_link_flags.append('-L/usr/local/lib')
elif is_win:
	my_ld_flags = ['advapi32.lib']
	my_cxx_flags = ['/std:c++17', '/EHsc', '/D_CRT_SECURE_NO_WARNINGS', '/D_CRT_NONSTDC_NO_DEPRECATE']
	my_cflags = ['/O2', '/W3', '/D_CRT_SECURE_NO_WARNINGS', '/D_CRT_NONSTDC_NO_DEPRECATE', '/D_USE_MATH_DEFINES']
	my_link_flags = [
		'/LIBPATH:src',
		'/LIBPATH:' + daoroot + '/lib',
		'/LIBPATH:' + vcpkg + '/lib',
	]
else:
	my_ld_flags = ['-lrt']
	my_cxx_flags = ['']
	my_cflags = ['-Ofast', '-march=native', '-funroll-loops']
	my_link_flags = ['-Lsrc', '-L' + daoroot + '/lib/', '-L' + daoroot + '/lib64/']

includes = '../include ' + daoroot + '/include/'
if is_win:
	includes += ' ' + wincompat + ' ' + vcpkg + '/include'

def dao_c_prog(name, source=None, ncurses=False, extra_ld=None, extra_cflags=None):
	"""Register a C tool program with platform-appropriate flags."""
	if is_win and ncurses:
		print('Skipping %s (ncurses not available on Windows build).' % name)
		return
	src = source or (name + '.c')
	cflags = list(my_cflags)
	if extra_cflags:
		cflags += extra_cflags
	elif not is_win:
		cflags += ['-Wall', '-Wextra', '-pipe', '-fdiagnostics-color=auto']

	kw = dict(
		source=src,
		target=name,
		includes=includes,
		linkflags=my_link_flags,
		use='daoTools',
	)
	if is_win:
		kw['cflags'] = cflags
		libs = ['dao', 'pthreadVC3']
		kw['lib'] = libs
		kw['ldflags'] = list(my_ld_flags)
	else:
		kw['cflags'] = cflags
		ld = ['-ldao', '-lpthread', '-lm'] + list(my_ld_flags)
		if ncurses:
			ld.append('-lncurses')
		if extra_ld:
			ld += extra_ld
		kw['ldflags'] = ld
	bld.program(**kw)


