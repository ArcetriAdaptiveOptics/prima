  <property name="windowTitle">
   <string>ORCA Control</string>
  </property>
  <property name="styleSheet">
   <string notr="true">QWidget#Form {
    background-color: #0b1740;
}

QLabel, QCheckBox, QGroupBox, QSpinBox, QDoubleSpinBox, QComboBox {
    color: #e8eef7;
}

QFrame#frame, QFrame#frame_2 {
    background-color: rgba(24, 72, 120, 0.22);
    border: 1px solid rgba(48, 192, 168, 0.35);
    border-radius: 6px;
}

QPushButton {
    background-color: rgba(24, 72, 120, 0.55);
    color: #eaf6f2;
    border: 1px solid #30c0a8;
    border-radius: 4px;
    padding: 3px 6px;
}
QPushButton:hover   { background-color: rgba(48, 192, 168, 0.30); }
QPushButton:pressed { background-color: rgba(48, 192, 168, 0.50); }
QPushButton:checked { background-color: #30c0a8; color: #05122e; }

QSpinBox, QDoubleSpinBox, QComboBox {
    background-color: rgba(5, 12, 34, 0.6);
    border: 1px solid #1860a8;
    border-radius: 3px;
    padding: 1px 3px;
}

QCheckBox::indicator {
    width: 14px; height: 14px;
    border: 1px solid #30c0a8;
    border-radius: 3px;
    background: rgba(5, 12, 34, 0.6);
}
QCheckBox::indicator:checked { background: #30c0a8; }

QProgressBar {
    border: 1px solid #1860a8;
    border-radius: 4px;
    text-align: center;
    color: #e8eef7;
    background: rgba(5, 12, 34, 0.5);
}
QProgressBar::chunk {
    background-color: #30c0a8;
    border-radius: 3px;
}

QLabel#logLabel, QLabel#logBgLabel {
    border: 1px solid #c0a818;
    border-radius: 3px;
    color: #f0d873;
}

QComboBox QAbstractItemView {
    background-color: #10224f;
    color: #e8eef7;
    selection-background-color: #1860a8;
    selection-color: #ffffff;
    border: 1px solid #30c0a8;
    outline: 0;
}
</string>
  </property>
