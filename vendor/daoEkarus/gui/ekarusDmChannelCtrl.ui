  <property name="styleSheet">
   <string notr="true">QMainWindow, QWidget {
    background-color: #0b1740;
    color: #e8eef7;
}

QLabel, QCheckBox, QGroupBox, QSpinBox, QDoubleSpinBox, QComboBox {
    color: #e8eef7;
}

QPushButton {
    background-color: rgba(24, 72, 120, 0.55);
    color: #eaf6f2;
    border: 1px solid #30c0a8;
    border-radius: 4px;
    padding: 3px 6px;
}
QPushButton:hover   { background-color: rgba(48, 192, 168, 0.30); }
QPushButton:pressed { background-color: rgba(48, 192, 168, 0.50); }
QPushButton:checked { background-color: rgba(48, 192, 168, 0.50); }

QSlider::groove:horizontal {
    background: rgba(5, 12, 34, 0.6);
    height: 6px;
    border-radius: 3px;
}
QSlider::handle:horizontal {
    background: #30c0a8;
    width: 14px;
    height: 14px;
    margin: -4px 0;
    border-radius: 7px;
}
QSlider::sub-page:horizontal {
    background: #1860a8;
    border-radius: 3px;
}
</string>
  </property>
