  <property name="windowTitle">
   <string>Telescope Control Display</string>
  </property>
  <property name="styleSheet">
   <string notr="true">QMainWindow, QWidget {
    background-color: #0b1740;
    color: #e8eef7;
}

QLabel { color: #e8eef7; }

QPushButton {
    background-color: rgba(24, 72, 120, 0.55);
    color: #eaf6f2;
    border: 1px solid #30c0a8;
    border-radius: 4px;
    padding: 3px 6px;
}
QPushButton:hover   { background-color: rgba(48, 192, 168, 0.30); }
QPushButton:pressed { background-color: rgba(48, 192, 168, 0.50); }
QPushButton:checked { background-color: rgba(48, 192, 168, 0.55);
                      border: 1px solid #30c0a8; }

QDoubleSpinBox, QComboBox {
    background-color: rgba(5, 12, 34, 0.6);
    color: #e8eef7;
    border: 1px solid #1860a8;
}

QGroupBox {
    border: 1px solid #30c0a8;
    border-radius: 6px;
    margin-top: 10px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 5px;
    color: #7fe0d0;
    font-weight: bold;
}
</string>
  </property>
